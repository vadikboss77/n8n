{
  "name": "@n8n/ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Business AI agent service with daily scheduler and HTTP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "src/index.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onCompilationComplete \"tsc-alias -p tsconfig.build.json && node dist/index.js\"",
    "format": "biome format --write src",
    "format:check": "biome ci src",
    "lint": "eslint . --quiet",
    "lintfix": "eslint . --fix",
    "start": "node dist/index.js",
    "watch": "tsc-watch -p tsconfig.build.json --onCompilationComplete \"tsc-alias -p tsconfig.build.json\""
  },
  "dependencies": {
    "@langchain/core": "catalog:",
    "@langchain/openai": "catalog:",
    "axios": "catalog:",
    "cron": "3.1.7",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "html-to-text": "9.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@n8n/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "*",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.10",
    "tsc-watch": "^6.2.0",
    "typescript": "*"
  }
}